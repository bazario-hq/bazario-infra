# Copy to env/prod-sim.env and adjust. No real secrets belong in this file.
COMPOSE_PROJECT_NAME=bazario-prod-sim
NODE_ENV=production
LOG_LEVEL=info
API_TAG=latest
WEB_TAG=latest

POSTGRES_USER=bazario
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bazario
POSTGRES_PORT=5434
DATABASE_POOL_MAX=10

S3_ACCESS_KEY=bazario
S3_SECRET_KEY=change-me-too
S3_BUCKET=bazario-images
S3_PORT=9200
S3_BROWSER_PORT=9201

TOXIPROXY_API_PORT=8674
API_PORT=3200
WEB_PORT=8180
WEB_API_URL=http://localhost:3200
MAILPIT_UI_PORT=8225
SMTP_HOST=mailpit
SMTP_PORT=1025

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

GRAFANA_PORT=3201
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9290
PROMETHEUS_RETENTION=15d

LOAD_SCENARIO=mixed
TRAFFIC_MULTIPLIER=1
