# Copy to env/dev.env and adjust. No real secrets belong in this file.
COMPOSE_PROJECT_NAME=bazario-dev
NODE_ENV=development
LOG_LEVEL=debug
API_TAG=latest
WEB_TAG=latest

POSTGRES_USER=bazario
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bazario
POSTGRES_PORT=5432
DATABASE_POOL_MAX=10

S3_ACCESS_KEY=bazario
S3_SECRET_KEY=change-me-too
S3_BUCKET=bazario-images
S3_PORT=9000
S3_BROWSER_PORT=9001

TOXIPROXY_API_PORT=8474
API_PORT=3000
WEB_PORT=5173
