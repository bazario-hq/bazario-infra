MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=2d

LOAD_SCENARIO=mixed
