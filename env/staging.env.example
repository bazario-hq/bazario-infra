# Copy to env/staging.env and adjust. No real secrets belong in this file.
COMPOSE_PROJECT_NAME=bazario-staging
NODE_ENV=production
LOG_LEVEL=info
API_TAG=latest
WEB_TAG=latest

POSTGRES_USER=bazario
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bazario
POSTGRES_PORT=5433
DATABASE_POOL_MAX=10

S3_ACCESS_KEY=bazario
S3_SECRET_KEY=change-me-too
S3_BUCKET=bazario-images
S3_PORT=9100
S3_BROWSER_PORT=9101

TOXIPROXY_API_PORT=8574
API_PORT=3100
WEB_PORT=8080
WEB_API_URL=http://localhost:3100
MAILPIT_UI_PORT=8125
SMTP_HOST=mailpit
SMTP_PORT=1025

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

GRAFANA_PORT=3101
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9190
PROMETHEUS_RETENTION=7d

LOAD_SCENARIO=mixed
TRAFFIC_MULTIPLIER=1
